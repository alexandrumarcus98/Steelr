{
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": false,
    "~/.copilot/instructions": false,
    "~/.claude/rules": false
  },
  "chat.promptFilesLocations": {
    ".github/prompts": true
  },
  "chat.includeApplyingInstructions": true,
  "chat.includeReferencedInstructions": false,
  "chat.useCustomizationsInParentRepositories": true,
  "chat.useClaudeMdFile": false,
  "chat.useAgentsMdFile": false,
  "chat.useNestedAgentsMdFiles": false,
  "github.copilot.chat.codesearch.enabled": false,
  "github.copilot.chat.localeOverride": "en",
  "github.copilot.chat.terminalChatLocation": "chatView",
  "chat.checkpoints.enabled": true,
  "chat.checkpoints.showFileChanges": false,
  "chat.requestQueuing.defaultAction": "queue",
  "inlineChat.finishOnType": false,
  "github.copilot.chat.editor.temporalContext.enabled": false,
  "editor.inlineSuggest.minShowDelay": 0,
  "editor.inlineSuggest.syntaxHighlightingEnabled": true,
  "editor.inlineSuggest.showToolbar": "onHover",
  "inlineChat.askInChat": true,
  "inlineChat.renderMode": "hover",
  "chat.permissions.default": "default",
  "chat.tools.terminal.autoReplyToPrompts": false,
  "chat.tools.terminal.outputLocation": "chat",
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.renameSuggestions.triggerAutomatically": true
}
