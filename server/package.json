{
	"name": "server",
	"version": "1.0.0",
	"description": "Express + Node.js server with TypeScript",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc && tsc-alias",
		"start": "node dist/index.js",
		"dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register server.ts",
		"seed": "ts-node-dev --transpile-only -r tsconfig-paths/register src/mock-up/seed/index.ts",
		"delete": "ts-node-dev --transpile-only -r tsconfig-paths/register src/mock-up/delete/index.ts"
	},
	"dependencies": {
		"@faker-js/faker": "^10.4.0",
		"axios": "^1.16.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^4.18.2",
		"express-rate-limit": "^8.4.1",
		"helmet": "^8.1.0",
		"hpp": "^0.2.3",
		"ip-geolocation-api-javascript-sdk": "^3.0.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.5.0",
		"morgan": "^1.10.1",
		"nodemailer": "^8.0.6"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.21",
		"@types/hpp": "^0.2.7",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^20.11.5",
		"@types/nodemailer": "^8.0.0",
		"ts-node-dev": "^2.0.0",
		"tsc-alias": "^1.8.16",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.3.3"
	}
}
